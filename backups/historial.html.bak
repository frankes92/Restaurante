<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<title>RestoGest POS — Historial</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
<link rel="stylesheet" href="styles.css">
<style>
  .filter-row { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }
  .filter-pill {
    padding: 8px 16px; border-radius: 20px;
    background: var(--bg-white); border: 1px solid var(--border);
    cursor: pointer; font-size: 12px; font-weight: 600;
    color: var(--text-dark); display: flex; align-items: center; gap: 6px;
    font-family: inherit;
  }
  .filter-pill.active { background: var(--primary); color: #fff; border-color: var(--primary); }
  .pay-icon {
    width: 30px; height: 30px; border-radius: 8px;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 12px;
  }
</style>
</head>
<body>
<div class="app">
  <div id="sidebar-mount"></div>

  <main class="main">
    <div class="page-header">
      <div>
        <div class="page-title">Historial</div>
        <div class="page-subtitle">Registro completo de órdenes finalizadas</div>
      </div>
      <button class="btn" onclick="exportCSV()"><i class="fa-solid fa-download"></i> Exportar CSV</button>
    </div>

    <div class="page-content">
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-icon" style="background:var(--primary-light);color:var(--primary);"><i class="fa-solid fa-receipt"></i></div>
          <div class="stat-label">ÓRDENES TOTALES</div>
          <div class="stat-value" id="s-count">0</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon" style="background:var(--green-light);color:var(--green);"><i class="fa-solid fa-money-bill-wave"></i></div>
          <div class="stat-label">VENTAS TOTALES</div>
          <div class="stat-value" id="s-total">S/ 0</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon" style="background:#fef3c7;color:var(--orange);"><i class="fa-solid fa-chart-line"></i></div>
          <div class="stat-label">TICKET PROMEDIO</div>
          <div class="stat-value" id="s-avg">S/ 0</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon" style="background:#dbeafe;color:var(--blue);"><i class="fa-solid fa-calendar-day"></i></div>
          <div class="stat-label">VENTAS HOY</div>
          <div class="stat-value" id="s-today">S/ 0</div>
        </div>
      </div>

      <div class="filter-row">
        <button class="filter-pill active" data-filter="all">Todos</button>
        <button class="filter-pill" data-filter="hoy">Hoy</button>
        <button class="filter-pill" data-filter="semana">Esta semana</button>
        <button class="filter-pill" data-filter="mes">Este mes</button>
        <button class="filter-pill" data-pay="efectivo"><i class="fa-solid fa-money-bill" style="color:var(--green);"></i> Efectivo</button>
        <button class="filter-pill" data-pay="tarjeta"><i class="fa-regular fa-credit-card" style="color:var(--blue);"></i> Tarjeta</button>
        <button class="filter-pill" data-pay="yape"><i class="fa-solid fa-mobile-screen" style="color:var(--primary);"></i> Yape</button>
        <input id="search-history" class="input-field" placeholder="Buscar #orden..." style="margin-left:auto;max-width:240px;">
      </div>

      <div class="table-container">
        <table class="data-table">
          <thead>
            <tr>
              <th>#ORDEN</th>
              <th>FECHA</th>
              <th>TIPO</th>
              <th>MESA</th>
              <th>ITEMS</th>
              <th>MÉTODO</th>
              <th>TOTAL</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="history-body"></tbody>
        </table>
      </div>
    </div>

    <div id="footer-mount"></div>
  </main>
</div>

<script src="app.js"></script>
<script>
  initLayout('historial');

  let dateFilter = 'all';
  let payFilter = null;
  let searchTerm = '';

  const TYPE_LABELS = { dine_in: 'Dine In', para_llevar: 'Para Llevar', delivery: 'Delivery' };
  const TYPE_BADGE = { dine_in: 'badge-purple', para_llevar: 'badge-orange', delivery: 'badge-blue' };
  const PAY_LABELS = { efectivo: 'Efectivo', tarjeta: 'Tarjeta', yape: 'Yape/Plin', transferencia: 'Transferencia' };
  const PAY_ICONS = { efectivo: { i: 'fa-money-bill', c: 'var(--green)', bg: 'var(--green-light)' }, tarjeta: { i: 'fa-credit-card', c: 'var(--blue)', bg: '#dbeafe' }, yape: { i: 'fa-mobile-screen', c: 'var(--primary)', bg: 'var(--primary-light)' }, transferencia: { i: 'fa-building-columns', c: 'var(--orange)', bg: '#fef3c7' } };

  function isInRange(iso, range) {
    const d = new Date(iso);
    const now = new Date();
    if (range === 'hoy') return d.toDateString() === now.toDateString();
    if (range === 'semana') return (now - d) <= 7 * 86400000;
    if (range === 'mes') return d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear();
    return true;
  }

  function render() {
    let orders = Orders.all().filter(o => o.status === 'pagada');

    document.getElementById('s-count').textContent = orders.length;
    document.getElementById('s-total').textContent = fmt.money(orders.reduce((s, o) => s + o.total, 0));
    document.getElementById('s-avg').textContent = orders.length ? fmt.money(orders.reduce((s, o) => s + o.total, 0) / orders.length) : 'S/ 0.00';
    const todayTotal = orders.filter(o => isInRange(o.createdAt, 'hoy')).reduce((s, o) => s + o.total, 0);
    document.getElementById('s-today').textContent = fmt.money(todayTotal);

    if (dateFilter !== 'all') orders = orders.filter(o => isInRange(o.createdAt, dateFilter));
    if (payFilter) orders = orders.filter(o => o.paymentMethod === payFilter);
    if (searchTerm) orders = orders.filter(o => o.id.includes(searchTerm));

    const body = document.getElementById('history-body');
    if (orders.length === 0) {
      body.innerHTML = `<tr><td colspan="8"><div class="empty-state">
        <i class="fa-solid fa-clock-rotate-left"></i><h3>Sin órdenes</h3><p>No hay registros con ese filtro</p>
      </div></td></tr>`;
      return;
    }
    body.innerHTML = orders.map(o => {
      const pay = PAY_ICONS[o.paymentMethod] || PAY_ICONS.efectivo;
      return `
        <tr>
          <td><span style="font-weight:700;">#${o.id}</span></td>
          <td>
            <div style="font-size:13px;">${fmt.date(o.createdAt)}</div>
            <div style="font-size:11px;color:var(--text-muted);">${fmt.time(o.createdAt)}</div>
          </td>
          <td><span class="badge ${TYPE_BADGE[o.type]}">${TYPE_LABELS[o.type]}</span></td>
          <td>${o.table ? 'Mesa ' + o.table : '—'}</td>
          <td>${o.items.reduce((s, i) => s + i.qty, 0)} productos</td>
          <td>
            <div style="display:flex;align-items:center;gap:8px;">
              <span class="pay-icon" style="background:${pay.bg};color:${pay.c};"><i class="fa-solid ${pay.i}"></i></span>
              <span style="font-size:13px;">${PAY_LABELS[o.paymentMethod] || '—'}</span>
            </div>
          </td>
          <td style="font-weight:700;color:var(--primary);">${fmt.money(o.total)}</td>
          <td style="text-align:right;">
            <button class="btn btn-sm btn-icon" onclick="viewDetails('${o.id}')"><i class="fa-solid fa-eye"></i></button>
            <button class="btn btn-sm btn-icon" onclick="printOrder('${o.id}')"><i class="fa-solid fa-print"></i></button>
          </td>
        </tr>
      `;
    }).join('');
  }

  window.viewDetails = (id) => {
    const o = Orders.all().find(x => x.id === id);
    if (!o) return;
    const detail = `Orden #${o.id}\nFecha: ${fmt.datetime(o.createdAt)}\nTipo: ${TYPE_LABELS[o.type]}\n${o.table ? 'Mesa: ' + o.table + '\n' : ''}Mesero: ${o.waiter}\nMétodo: ${PAY_LABELS[o.paymentMethod] || '—'}\n\n` +
      o.items.map(i => `${i.qty}× ${i.name}${i.note ? ' (' + i.note + ')' : ''} — ${fmt.money(i.price * i.qty)}`).join('\n') +
      `\n\nSubtotal: ${fmt.money(o.subtotal)}\nIGV: ${fmt.money(o.tax)}\nTotal: ${fmt.money(o.total)}`;
    alert(detail);
  };

  window.printOrder = (id) => showToast('Imprimiendo orden #' + id, 'success');

  window.exportCSV = () => {
    const orders = Orders.all().filter(o => o.status === 'pagada');
    const rows = [['#Orden', 'Fecha', 'Tipo', 'Mesa', 'Items', 'Método', 'Subtotal', 'IGV', 'Total']];
    orders.forEach(o => rows.push([
      o.id, fmt.datetime(o.createdAt), TYPE_LABELS[o.type], o.table || '',
      o.items.reduce((s, i) => s + i.qty, 0),
      PAY_LABELS[o.paymentMethod] || '', o.subtotal, o.tax, o.total
    ]));
    const csv = rows.map(r => r.join(',')).join('\n');
    const blob = new Blob([csv], { type: 'text/csv' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'historial_ordenes.csv';
    a.click();
    showToast('CSV descargado', 'success');
  };

  document.querySelectorAll('.filter-pill').forEach(b => b.addEventListener('click', () => {
    if (b.dataset.filter) {
      document.querySelectorAll('.filter-pill[data-filter]').forEach(x => x.classList.remove('active'));
      b.classList.add('active');
      dateFilter = b.dataset.filter;
    } else if (b.dataset.pay) {
      const wasActive = b.classList.contains('active');
      document.querySelectorAll('.filter-pill[data-pay]').forEach(x => x.classList.remove('active'));
      if (!wasActive) { b.classList.add('active'); payFilter = b.dataset.pay; }
      else { payFilter = null; }
    }
    render();
  }));

  document.getElementById('search-history').addEventListener('input', e => {
    searchTerm = e.target.value;
    render();
  });

  render();
</script>
</body>
</html>
