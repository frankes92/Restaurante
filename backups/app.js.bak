/* ---------- HELPERS ---------- */
const fmt = {
  money: (n) => 'S/ ' + Number(n).toFixed(2),
  date: (iso) => {
    const d = new Date(iso);
    return d.toLocaleDateString('es-PE', { day: '2-digit', month: '2-digit', year: 'numeric' });
  },
  time: (iso) => {
    const d = new Date(iso);
    return d.toLocaleTimeString('es-PE', { hour: '2-digit', minute: '2-digit' });
  },
  datetime: (iso) => `${fmt.date(iso)} ${fmt.time(iso)}`,
};

function uid() { return Math.random().toString(36).slice(2, 10); }

function nextOrderId() {
  let counter = Store.get(Store.KEYS.counter, 1);
  counter += 1;
  Store.set(Store.KEYS.counter, counter);
  return String(counter).padStart(5, '0');
}

function showToast(message, type = '') {
  let el = document.querySelector('.toast');
  if (!el) {
    el = document.createElement('div');
    el.className = 'toast';
    document.body.appendChild(el);
  }
  el.className = 'toast ' + type;
  el.innerHTML = `<i class="fa-solid fa-${type === 'error' ? 'circle-xmark' : 'circle-check'}"></i> ${message}`;
  requestAnimationFrame(() => el.classList.add('show'));
  setTimeout(() => el.classList.remove('show'), 2500);
}

/* ---------- COMPONENTS: SIDEBAR & FOOTER ---------- */
function renderSidebar(activePage) {
  const items = [
    { id: 'index', icon: 'fa-regular fa-file-lines', label: 'Nueva Orden', href: 'index.html' },
    { id: 'mesas', icon: 'fa-solid fa-table-cells-large', label: 'Mesas', href: 'mesas.html' },
    { id: 'pedidos', icon: 'fa-solid fa-receipt', label: 'Pedidos', href: 'pedidos.html' },
    { id: 'clientes', icon: 'fa-regular fa-user', label: 'Clientes', href: 'clientes.html' },
    { id: 'historial', icon: 'fa-regular fa-clock', label: 'Historial', href: 'historial.html' },
    { id: 'caja', icon: 'fa-solid fa-cash-register', label: 'Caja', href: 'caja.html' },
    { id: 'reportes', icon: 'fa-regular fa-chart-bar', label: 'Reportes', href: 'reportes.html' },
    { id: 'mas', icon: 'fa-solid fa-ellipsis', label: 'Más Opciones', href: '#' },
  ];

  return `
    <aside class="sidebar">
      <a href="index.html" class="logo">
        <div class="logo-icon">🍲</div>
        <div class="logo-text"><span>Resto<em>Gest</em></span><span class="logo-pos">POS</span></div>
      </a>
      <nav class="nav">
        ${items.map(it => `
          <a href="${it.href}" class="nav-item ${it.id === activePage ? 'active' : ''}">
            <i class="${it.icon}"></i> ${it.label}
          </a>
        `).join('')}
      </nav>
      <div class="sidebar-footer">
        <div class="user-info">
          <div class="user-avatar">JP</div>
          <div>
            <div class="user-name">Juan Pérez</div>
            <div class="user-role">Cajero</div>
          </div>
        </div>
        <div class="branch-selector">
          <div>
            <div class="branch-name">Sucursal Centro</div>
            <div class="branch-status">Abierta</div>
          </div>
          <i class="fa-solid fa-chevron-down" style="font-size:11px;color:#9ca3af;"></i>
        </div>
        <a href="#" class="logout"><i class="fa-solid fa-right-from-bracket"></i> Cerrar Sesión</a>
      </div>
    </aside>
  `;
}

function renderFooter() {
  const session = Store.get(Store.KEYS.cashSession, {});
  const now = new Date();
  return `
    <div class="footer">
      <div class="footer-item">Caja: ${session.caja || 'AP-001'}</div>
      <div class="footer-divider"></div>
      <div class="footer-item">Apertura: ${session.openedAt ? fmt.datetime(session.openedAt) : '—'}</div>
      <div class="footer-divider"></div>
      <div class="footer-item">Turno: ${session.turno || 'Mañana'}</div>
      <div class="footer-right">
        <div class="footer-item">Conexión <span class="online"><i class="fa-solid fa-wifi"></i> En línea</span></div>
        <div class="footer-divider"></div>
        <div class="footer-item"><i class="fa-regular fa-clock"></i> <span id="footer-clock">${fmt.time(now)}</span> &nbsp; ${fmt.date(now)}</div>
      </div>
    </div>
  `;
}

/* ---------- INITIALIZATION ---------- */
function initLayout(activePage) {
  seedDataIfNeeded();
  const sidebarMount = document.getElementById('sidebar-mount');
  const footerMount = document.getElementById('footer-mount');
  if (sidebarMount) sidebarMount.outerHTML = renderSidebar(activePage);
  if (footerMount) footerMount.outerHTML = renderFooter();

  // Reloj
  setInterval(() => {
    const clock = document.getElementById('footer-clock');
    if (clock) clock.textContent = fmt.time(new Date());
  }, 30000);
}

/* ---------- CRUD HELPERS ---------- */
const Orders = {
  all: () => Store.get(Store.KEYS.orders, []),
  add: (order) => {
    const list = Orders.all();
    list.unshift(order);
    Store.set(Store.KEYS.orders, list);
  },
  update: (id, patch) => {
    const list = Orders.all();
    const idx = list.findIndex(o => o.id === id);
    if (idx >= 0) {
      list[idx] = { ...list[idx], ...patch };
      Store.set(Store.KEYS.orders, list);
    }
  },
  remove: (id) => {
    const list = Orders.all().filter(o => o.id !== id);
    Store.set(Store.KEYS.orders, list);
  },
};

const Customers = {
  all: () => Store.get(Store.KEYS.customers, []),
  add: (c) => { const l = Customers.all(); l.unshift(c); Store.set(Store.KEYS.customers, l); },
  update: (id, patch) => {
    const l = Customers.all();
    const i = l.findIndex(c => c.id === id);
    if (i >= 0) { l[i] = { ...l[i], ...patch }; Store.set(Store.KEYS.customers, l); }
  },
  remove: (id) => Store.set(Store.KEYS.customers, Customers.all().filter(c => c.id !== id)),
};

const Tables = {
  all: () => Store.get(Store.KEYS.tables, []),
  update: (id, patch) => {
    const l = Tables.all();
    const i = l.findIndex(t => t.id === id);
    if (i >= 0) { l[i] = { ...l[i], ...patch }; Store.set(Store.KEYS.tables, l); }
  },
  add: (t) => { const l = Tables.all(); l.push(t); Store.set(Store.KEYS.tables, l); },
  remove: (id) => Store.set(Store.KEYS.tables, Tables.all().filter(t => t.id !== id)),
};

const Cash = {
  movements: () => Store.get(Store.KEYS.cashMovements, []),
  addMovement: (m) => {
    const l = Cash.movements();
    l.unshift({ id: uid(), createdAt: new Date().toISOString(), ...m });
    Store.set(Store.KEYS.cashMovements, l);
  },
  session: () => Store.get(Store.KEYS.cashSession, {}),
  setSession: (s) => Store.set(Store.KEYS.cashSession, s),
};

/* expose globally for inline HTML calls */
window.Store = Store;
window.Orders = Orders;
window.Customers = Customers;
window.Tables = Tables;
window.Cash = Cash;
window.fmt = fmt;
window.showToast = showToast;
window.uid = uid;
window.nextOrderId = nextOrderId;
window.initLayout = initLayout;
